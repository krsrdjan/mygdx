{
  // VS Code / Cursor launch configurations for libGDX (desktop + TeaVM web)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Desktop (libGDX)",
      "type": "java",
      "request": "launch",
      "mainClass": "com.mygdx.game.DesktopLauncher",
      "projectName": "desktop",
      "cwd": "${workspaceFolder}/assets"
    },
    {
      "name": "Debug Desktop (libGDX)",
      "type": "java",
      "request": "launch",
      "mainClass": "com.mygdx.game.DesktopLauncher",
      "projectName": "desktop",
      "cwd": "${workspaceFolder}/assets",
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
    {
      "name": "Run Web (Gradle :teavm:run)",
      "type": "java",
      "request": "launch",
      "mainClass": "org.gradle.wrapper.GradleWrapperMain",
      "classPaths": ["${workspaceFolder}/gradle/wrapper/gradle-wrapper.jar"],
      "modulePaths": [],
      "args": [":teavm:run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}


